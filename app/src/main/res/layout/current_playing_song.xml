<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/CurrentPlayingSongLayout"
        android:layout_width="392dp"
        android:layout_height="58dp"
        android:background="@drawable/rounded_button"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="6dp"
            app:cardElevation="4dp">

            <ImageButton
                android:id="@+id/ImageAlbCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/current_song"
                android:scaleType="centerInside"
                android:src="@drawable/ari_album"
                app:cardBackgroundColor="@android:color/transparent" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro"
                android:maxLines="1"
                android:text="@string/twilight_zone"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro"
                android:maxLines="1"
                android:text="@string/ariana_grande"
                android:textColor="#B3B3B3"
                android:textSize="11sp" />
        </LinearLayout>
        <!-- Add space -->
        <View
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="0.8" />

        <ImageButton
            android:id="@+id/ConnectToDevicesButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center|end"
            android:background="@android:color/transparent"
            android:contentDescription="@string/connect_to_device"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/connect_to_device"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/PlayPauseButtons"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center|end"
            android:background="@android:color/transparent"
            android:contentDescription="@string/play_pause_buttons"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/pause1"
            app:tint="@color/white" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="378dp"
        android:layout_height="2dp"
        android:layout_marginTop="56dp"
        android:backgroundTint="#B3B3B3"
        android:max="100"
        android:progress="50"
        android:progressTint="@color/white"
        app:layout_constraintEnd_toEndOf="@+id/CurrentPlayingSongLayout"
        app:layout_constraintStart_toStartOf="@+id/CurrentPlayingSongLayout"
        app:layout_constraintTop_toTopOf="@+id/CurrentPlayingSongLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>